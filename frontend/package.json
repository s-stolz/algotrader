{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .mjs,.ts,.vue",
    "typecheck": "vue-tsc --noEmit",
    "test:layout": "node scripts/check-test-layout.mjs",
    "test:unit": "vitest run",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "check:readability": "node scripts/check-readability.mjs",
    "check:readability:inventory": "node scripts/check-readability.mjs --inventory",
    "test:tooling": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@vue/devtools-api": "8.2.1",
    "echarts": "6.1.0",
    "lightweight-charts": "5.3.0",
    "mitt": "3.0.1",
    "pinia": "4.1.0",
    "vue": "3.5.45",
    "vue-echarts": "8.3.2",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vicons/ionicons5": "0.13.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "jsdom": "31.0.0",
    "naive-ui": "2.45.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.14"
  }
}
