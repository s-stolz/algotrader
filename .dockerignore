.git
.gitignore
**/.venv
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.vscode
**/*.pyc
**/*.pyo
**/*.pyd
**/*.log
**/.DS_Store
config/.env*
frontend/node_modules
frontend/dist

# Local strategies are mounted at runtime, never baked into images.
backtester/src/strategies/custom/*
!backtester/src/strategies/custom/__init__.py
backtester/private/

**/*.egg-info
**/build

# Never bake local setup, credentials, or agent scratch artifacts into releases.
**/.env
**/.env.*
config/topology.local.yaml
.scratch
.agents
.codex
