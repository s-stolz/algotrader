# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Database Accessor API Configuration
DB_ACCESSOR_API_HOST=database-accessor-api
DB_ACCESSOR_API_PORT=8000

# Broker Service API Configuration
BROKER_SERVICE_HOST=broker-service
BROKER_SERVICE_PORT=8050

# Broker Service Configuration (for Redis stream patterns)
BROKER_ACCOUNT_ID=12345

# Logging
LOG_LEVEL=INFO

# Consumer Configuration
CONSUMER_BATCH_SIZE=100
CONSUMER_BLOCK_MS=5000
